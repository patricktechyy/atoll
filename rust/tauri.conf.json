{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atoll",
  "version": "../app/package.json",
  "identifier": "app.atoll.notch",
  "build": {
    "frontendDist": "../.cache/rust-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: atoll: http://atoll.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../app/assets/icon.png",
      "../app/assets/icon.ico"
    ],
    "resources": {
      "../.cache/rust-helper/": "helper/",
      "../.cache/rust-notices.txt": "ThirdPartyNotices.txt"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "windows/electron-migration.nsh"
      }
    }
  },
  "mainBinaryName": "Atoll"
}
